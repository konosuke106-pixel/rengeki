# Cloudflare Pages が全ページに付ける安全用のヘッダー（npm run build で dist にコピーされる）
# 読み込み元を増やしたら Content-Security-Policy にも足すこと
#  - フォント：Google Fonts（fonts.googleapis.com の CSS と fonts.gstatic.com のフォント）
#  - オンライン対戦：jsDelivr の supabase-js と、Supabase の部屋（https / wss）
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://pneboddgrvktehjslplg.supabase.co wss://pneboddgrvktehjslplg.supabase.co; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
